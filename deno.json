{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "experimentalDecorators": true
  },
  "tasks": {
    "build:web": "deno run -A --node-modules-dir=auto npm:vite/vite build",
    "dev:web": "deno run -A --node-modules-dir=auto npm:vite/vite",
    "build": "deno task build:web",
    "dev": "deno task build:web && DENO_ENV=development deno run --env-file=.env --allow-net --allow-read --allow-env server/main.ts",
    "serve": "deno run --env-file=.env --allow-net --allow-read --allow-env server/main.ts",
    "test": "deno run -A --node-modules-dir=auto npm:vitest run",
    "test:watch": "deno run -A --node-modules-dir=auto npm:vitest",
    "check": "deno check server/main.ts web/src/index.ts",
    "lint": "deno lint server/ web/src/"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true
  },
  "exclude": ["web/dist"],
  "imports": {
    "@lit-labs/signals": "npm:@lit-labs/signals@^0.2.0",
    "@material/web": "npm:@material/web@^2.4.1",
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
"jose": "npm:jose@^6.1.3",
    "oauth4webapi": "npm:oauth4webapi@^3.8.5",
    "@tidal-music/api": "npm:@tidal-music/api@^0.8.1",
    "@tidal-music/auth": "npm:@tidal-music/auth@^1.4.0",
    "@tidal-music/common": "npm:@tidal-music/common@^0.2.0",
    "lit": "npm:lit@^3.3.1",
    "vite": "npm:vite@^7.3.1",
    "vitest": "npm:vitest@^4.0.18"
  }
}
